# ==============================================================================
# PS-02 PHISHING ATTACK INVESTIGATION PLATFORM — CONFIGURATION ENVIRONMENT
# ==============================================================================

# Application Settings
PROJECT_NAME="PS-02 Phishing Attack Investigation Platform"
ENVIRONMENT="development"
DEBUG=true

# Database (PostgreSQL or local SQLite fallback)
# Leave blank to use zero-config SQLite: sqlite:///./phishing_platform.db
DATABASE_URL="sqlite:///./phishing_platform.db"

# CORS Allowed Origins (Comma-separated list)
# Leave blank to allow standard localhost and auto-detected private LAN ranges
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Threat Intelligence Provider API Keys (Optional - gracefully falls back to "Unknown / Not checked")
VIRUSTOTAL_API_KEY=""
URLHAUS_API_KEY=""
ABUSEIPDB_API_KEY=""

# Grounded AI Security Analyst LLM Provider (Optional - defaults to deterministic heuristic analyst)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Frontend Environment Variables (Set in .env.local if you wish to override dynamic auto-detection)
# Example for explicit LAN IP: VITE_API_URL="http://192.168.1.100:8000/api"
VITE_API_URL=""
